+    def optimizer_step(self, epoch, batch_idx, optimizer, optimizer_closure):
+        """Skip optimizer.step for flagged bad batches and non-finite grads."""
+        # Run closure to compute gradients if required
+        loss = None
+        if optimizer_closure is not None:
+            loss = optimizer_closure()
+        # Check grads for non-finite values
+        bad_grad = False
+        for p in self.net.parameters():
+            if p.grad is not None and not torch.isfinite(p.grad).all():
+                bad_grad = True
+                break
+        if bad_grad:
+            try:
+                self._log_warn(f"WARN[BAD_GRAD] non-finite gradients at epoch={getattr(self, 'current_epoch', -1)} batch={batch_idx}")
+            except Exception:
+                pass
+            optimizer.zero_grad(set_to_none=True)
+            self._skip_optimizer_step = False
+            return
+        if getattr(self, "_skip_optimizer_step", False):
+            try:
+                self._log_warn(f"WARN[SKIP] skip optimizer step epoch={getattr(self, 'current_epoch', -1)} batch={batch_idx} ids={getattr(self, '_last_bad_utt_ids', [])[:16]}")
